# ==============================================================================
# CodeGuard AI - Environment Configuration Template
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Backend API Configuration
PORT=5000
JWT_SECRET=codeguard-super-secure-production-jwt-key-2026
JWT_EXPIRES_IN=7d
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
MAX_CODE_LENGTH_BYTES=524288

# PostgreSQL Database Configuration
POSTGRES_USER=codeguard
POSTGRES_PASSWORD=codeguard_secret
POSTGRES_DB=codeguard_db
DATABASE_URL=postgresql://codeguard:codeguard_secret@localhost:5432/codeguard_db

# Redis Cache Configuration
REDIS_URL=redis://localhost:6379

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# Modular AI Provider Selection: 'heuristic' | 'gemini' | 'openai' | 'anthropic'
# Default 'heuristic' runs offline without requiring third-party API keys.
AI_PROVIDER=heuristic

# Third-Party Provider Credentials (Optional when using 'heuristic')
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
